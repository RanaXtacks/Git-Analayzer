# ==============================================================================
# Git-Analyzer — Global Environment Configuration
# ==============================================================================

# Application Branding & Execution
APP_NAME=Git-Analyzer
APP_ENV=development
DEBUG=true

# Server Network Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional GitHub Personal Access Token (Never exposed to frontend)
# Unauthenticated: 60 requests/hour | Authenticated: 5,000 requests/hour
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# LLM Inference Configuration (No proprietary API required!)
# Provider options: "ollama" (local dev) | "vllm" (production)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=qwen3:8b
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1

# Database Configuration (PostgreSQL in production; SQLite or in-memory in minimal dev)
DATABASE_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./git_analyzer.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://git_analyzer:devpassword@localhost:5432/git_analyzer

# Cache Configuration (Redis in production; in-memory in minimal dev)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Rate Limiting (per minute per IP)
RATE_LIMIT_PER_MINUTE=5

# Repository Analysis & Context Limits
MAX_TREE_ENTRIES=5000
MAX_FILE_SIZE=200000
MAX_README_SIZE=100000
MAX_ISSUES=30
MAX_CONTEXT_SIZE=50000

# Concurrency & Timeout
MAX_ANALYSIS_DURATION=180
MAX_CONCURRENT_ANALYSES=5

# PostgreSQL Container Defaults (for docker compose)
POSTGRES_DB=git_analyzer
POSTGRES_USER=git_analyzer
POSTGRES_PASSWORD=devpassword
